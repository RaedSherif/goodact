@startuml GoodAct_UseCase
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "User (Buyer)" as User
actor Provider
actor Admin

rectangle "GoodAct System" {

  ' --- Authentication (pre-auth use cases) ---
  package "Authentication" {
    usecase "Register Account"   as UC_Register
    usecase "Login"              as UC_Login
    usecase "Logout"             as UC_Logout
  }

  ' --- User (role = 1) ---
  package "User (Buyer)" {
    usecase "Browse Listings"        as UC_Browse
    usecase "Sort Listings"          as UC_Sort
    usecase "Place Order"            as UC_Place
    usecase "Add Order Notes"        as UC_Notes
    usecase "View My Orders"         as UC_MyOrders
    usecase "Update Order Note"      as UC_UpdNote
    usecase "Cancel Order"           as UC_CancelOrder
    usecase "User Dashboard"         as UC_UDash
  }

  ' --- Provider (role = 2) ---
  package "Provider" {
    usecase "Provider Dashboard"      as UC_PDash
    usecase "Create Listing (EAV)"    as UC_AddListing
    usecase "Set Trait Name/Value"    as UC_Attrs
    usecase "Mark Listing Premium"    as UC_Premium
    usecase "Update Listing"          as UC_EditListing
    usecase "Delete Own Listing"      as UC_DelListing
    usecase "View Orders on Listings" as UC_POrders
  }

  ' --- Admin (role = 3) ---
  package "Admin" {
    usecase "Admin Dashboard"      as UC_ADash
    usecase "Manage Users"         as UC_MgrUsers
    usecase "Create User"          as UC_CreateUser
    usecase "Update User (role)"   as UC_UpdUser
    usecase "Delete User"          as UC_DelUser
    usecase "Delete Any Listing"   as UC_DelAnyListing
    usecase "Delete Any Order"     as UC_DelAnyOrder
  }

  ' --- Shared ---
  usecase "View/Edit Profile"  as UC_Profile

  ' --- Cross-cutting (system patterns) ---
  usecase "Role-Based Menu (Decorator)" as UC_Menu
  usecase "Log Auth Event (Observer)"   as UC_LogObs
}

' === User associations ===
User --> UC_Register
User --> UC_Login
User --> UC_UDash
User --> UC_Browse
User --> UC_Sort
User --> UC_Place
User --> UC_MyOrders
User --> UC_UpdNote
User --> UC_CancelOrder
User --> UC_Profile
User --> UC_Logout

' === Provider associations ===
Provider --> UC_Register
Provider --> UC_Login
Provider --> UC_PDash
Provider --> UC_AddListing
Provider --> UC_EditListing
Provider --> UC_DelListing
Provider --> UC_POrders
Provider --> UC_Profile
Provider --> UC_Logout

' === Admin associations (no self-register; seeded) ===
Admin --> UC_Login
Admin --> UC_ADash
Admin --> UC_MgrUsers
Admin --> UC_DelAnyListing
Admin --> UC_DelAnyOrder
Admin --> UC_Profile
Admin --> UC_Logout

' === include / extend ===
UC_Place        ..> UC_Notes      : <<extend>>
UC_AddListing   ..> UC_Attrs      : <<include>>
UC_AddListing   ..> UC_Premium    : <<extend>>
UC_EditListing  ..> UC_Premium    : <<extend>>

UC_MgrUsers     ..> UC_CreateUser : <<include>>
UC_MgrUsers     ..> UC_UpdUser    : <<include>>
UC_MgrUsers     ..> UC_DelUser    : <<include>>

UC_Login        ..> UC_LogObs     : <<include>>
UC_Register     ..> UC_LogObs     : <<include>>
UC_Logout       ..> UC_LogObs     : <<include>>

UC_UDash        ..> UC_Menu       : <<include>>
UC_PDash        ..> UC_Menu       : <<include>>
UC_ADash        ..> UC_Menu       : <<include>>

@enduml
